#!/bin/sh
# pre-commit hook (generated by release-kit install_hook).
# Auto-bumps the version in pubspec.yaml and stages it into the commit.
# To skip the bump (e.g. a release commit), use: git commit --no-verify

SMART_BUMP={SMART_BUMP_PATH}
PUBSPEC={PUBSPEC_PATH}
REPO_ROOT={REPO_ROOT}

cd "$REPO_ROOT" || exit 1

if command -v dart >/dev/null 2>&1; then
  if dart run "$SMART_BUMP" --pubspec "$PUBSPEC"; then
    git add "$PUBSPEC"
  else
    echo "pre-commit: version bump failed (see error above)." >&2
    echo "Use 'git commit --no-verify' to skip version bumping." >&2
    exit 1
  fi
else
  echo "pre-commit: 'dart' not found on PATH - version bump SKIPPED." >&2
  echo "Install the Dart SDK, or use 'git commit --no-verify' to skip." >&2
fi

exit 0
