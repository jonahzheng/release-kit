#!/bin/sh
# pre-commit hook (generated by release-kit install).
# Auto-bumps the version in pubspec.yaml and stages it into the commit.
# To skip the bump (e.g. a release commit), use: git commit --no-verify

PUBSPEC={PUBSPEC_PATH}
REPO_ROOT={REPO_ROOT}
SMART_BUMP={SMART_BUMP_PATH}

cd "$REPO_ROOT" || exit 1

bump() {
  if command -v release-kit >/dev/null 2>&1; then
    release-kit bump --pubspec "$PUBSPEC"
  elif [ -n "$SMART_BUMP" ] && [ -f "$SMART_BUMP" ] && command -v dart >/dev/null 2>&1; then
    dart run "$SMART_BUMP" --pubspec "$PUBSPEC"
  elif command -v dart >/dev/null 2>&1; then
    dart pub global run release_kit:release-kit bump --pubspec "$PUBSPEC"
  else
    echo "pre-commit: 'release-kit'/'dart' not found - version bump SKIPPED." >&2
    echo "Install release-kit: dart pub global activate release_kit" >&2
    return 0
  fi
}

if bump; then
  git add "$PUBSPEC"
else
  echo "pre-commit: version bump failed (see error above)." >&2
  echo "Use 'git commit --no-verify' to skip version bumping." >&2
  exit 1
fi

exit 0
